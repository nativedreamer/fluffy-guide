{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/analysis.js": {
      "maxDuration": 60,
      "includeFiles": "data/corner-booking-samples.json"
    },
    "api/fixtures.js": {
      "maxDuration": 60,
      "includeFiles": "data/corner-booking-samples.json"
    }
  }
}
